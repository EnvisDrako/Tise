# --------------------------------------------------
# Security & URL Rewriting Configuration
# --------------------------------------------------

<IfModule mod_rewrite.c>
RewriteEngine On

# --------------------------------------------------
# Clean URLs - redirect .php extension
# --------------------------------------------------
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# --------------------------------------------------
# Internal rewrite for clean URLs
# --------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L,QSA]

# --------------------------------------------------
# Prevent direct access to includes directory
# --------------------------------------------------
RewriteRule ^includes/ - [F,L]

# --------------------------------------------------
# Block common attack patterns (XSS, LFI, SQLi)
# --------------------------------------------------
RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
RewriteCond %{QUERY_STRING} (GLOBALS|_REQUEST)(=|\[) [NC,OR]
RewriteCond %{QUERY_STRING} (\.\./|\.\.\\) [NC,OR]
RewriteCond %{QUERY_STRING} (union.*select|insert.*into|drop.*table) [NC]
RewriteRule .* - [F,L]
</IfModule>

# --------------------------------------------------
# Security Headers (only if supported)
# --------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --------------------------------------------------
# Block hidden/system files
# --------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --------------------------------------------------
# Block backup and temp files
# --------------------------------------------------
<FilesMatch "\.(bak|backup|old|orig|save|swp|tmp)$">
    Require all denied
</FilesMatch>

# --------------------------------------------------
# Disable server signature
# --------------------------------------------------
ServerSignature Off
